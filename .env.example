# Copy this file to .env and fill in real values. .env is git-ignored and must never be committed.

DB_USERNAME=hobbs
DB_PASSWORD=changeme

# The frontend origin allowed to make cross-origin calls to the API. Leave blank for local testing
# to allow any origin.
CORS_ALLOWED_ORIGIN=https://hobbs.bssd.co.uk

# Caddy (TLS termination, reverse proxy, frontend static serving) now lives in its own compose stack
# in the hobbs-ui repo - DOMAIN/HTTP_PORT/HTTPS_PORT moved to that repo's own .env.example.

# SMTP credentials for sending pilot invite emails - an existing mailbox (e.g. Gmail with an app
# password) rather than a third-party transactional-email provider.
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=changeme@gmail.com
SMTP_PASSWORD=changeme
EMAIL_FROM_ADDRESS=changeme@gmail.com

# Base URL used to build the sign-up link sent in invite emails (POST /admin/invite).
FRONTEND_BASE_URL=https://hobbs.bssd.co.uk

# Whether /openapi and /swagger are served. Defaults to false for docker-compose deploys if unset -
# uncomment to opt back in for a local Docker-based dev stack.
# DOCS_ENABLED=true

# Database backups (docker/backup.sh, run via a VPS cron entry, not by the app itself - see
# docs/DEPLOYMENT.md). B2_ACCOUNT_ID/B2_ACCOUNT_KEY come from a Backblaze B2 Application Key scoped
# to a single bucket only, not the master key. RESTIC_REPOSITORY is "b2:<bucket-name>:hobbs".
# RESTIC_PASSWORD encrypts every snapshot - generate it once, save it in a password manager
# immediately (it lives only here and in your head - if this .env and the password manager entry are
# both lost, the backups in B2 are permanently unreadable, defeating the entire point of having them).
B2_ACCOUNT_ID=changeme
B2_ACCOUNT_KEY=changeme
RESTIC_REPOSITORY=b2:changeme:hobbs
RESTIC_PASSWORD=changeme

# Optional: a Better Stack Heartbeat URL, pinged by docker/backup.sh on every successful run. If the
# nightly backup stops running (or starts failing) the heartbeat goes quiet and Better Stack alerts,
# the same way it already does for a real outage - see status.bssd.co.uk. Leave blank to skip.
# BETTER_STACK_HEARTBEAT_URL=
